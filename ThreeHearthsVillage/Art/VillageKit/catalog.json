  "conventions": {
    "foundation": "Origin at centre of top surface Z=0; extends down to -0.24.",
    "floor": "Origin at floor structural datum; deck extends Z=0..0.16.",
    "frame": "Standalone frame prototype only; origin bay centre, Z=0; posts X/Y=+/-1, top Z=2.4. Multi-bay assemblies instead use post_timber_2_4m and beam_timber_2m placed once per grid vertex/edge.",
    "post": "Origin centre bottom; .18m square section, Z=0..2.4.",
    "beam": "Origin centre underside; longitudinal axis +X, actual span X=-.91..+.91 to fit between .18m posts on2m grid; Z=0..0.2. Place underside at storey datum+2.2, rotate90 degrees for Y edges.",
    "wall": "Origin centred on bay edge, Z=0; front -Y; infill width 1.82, thickness .16, Z=.16..2.24 between frame members. Rotate around Z to face other boundaries.",
    "roof_slope": "Origin at ridge projection on wall-top datum; ridge along Y at Z=1.20, slope towards +X to eave X=2.18/Z=0. A matching half rotates 180 degrees about Z. Along Y every panel is exactly 2m; place centres 2m apart.",
    "ridge": "Origin on wall-top datum, ridge along Y, bottom Z=1.20; span2m.",
    "gable": "Origin centre on 4m-wide end wall top; front -Y; apex Z=1.2.",
    "floor_opening": "Two side trimmers X=+/-0.95 only; ends are open so two consecutive pieces form an uninterrupted 1.8x4m stairwell. Never add a transverse beam through the opening.",
    "stairs": "Switchback in a2x4m two-bay stairwell; two .84m-wide flights with .20m risers/.24m treads, .90m-deep rear turn landing and .90m-deep upper exit landing. Climbs finished deck Z=.16 to2.56. Entrance X=-.48/Y=-1.02; upper exit landing X=.48/Y=-1.47 connects rightward to the upper floor. Use two floor_opening_2m at Y=+/-1, omit the first-floor transverse beam through Y=0. Collision and navigation require engine-authored treatment.",
    "carry": "Only carry-category packs are NPC-portable; building pieces are construction results, never hand-held whole walls or floors.",
    "exports": "Each modules/<id>.glb contains one joined mesh in local coordinates. GLTF uses standard +Y-up conversion; Blender source and these specs are +Z-up."
  },
